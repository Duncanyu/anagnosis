{
  # Optional: set a contact email for Let's Encrypt notifications
  # email you@example.com
}

{$DOMAIN} {
  encode zstd gzip

  # Route API traffic explicitly; strip the /api prefix for upstream
  handle_path /api* {
    reverse_proxy api:8000
  }

  # Everything else goes to the web UI
  handle {
    reverse_proxy web:7860
  }

  header /* {
    X-Frame-Options DENY
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    # HSTS (enable only after verifying HTTPS works):
    # Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  }
}

